{
  "name": "afo-mcp",
  "version": "0.1.0",
  "description": "MCP server for SAP Analysis for Office workbooks",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "afo-mcp": "dist/stdio.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/stdio.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "sap",
    "analysis-for-office",
    "excel",
    "bw",
    "mcp",
    "model-context-protocol"
  ],
  "author": "David Nicolay",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cfb": "^1.2.2",
    "fast-xml-parser": "^4.5.7",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
